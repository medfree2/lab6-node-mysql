      "delete": {
        "tags": [
          "Products"
        ],
        "summary": "Supprimer products",
        "responses": {
          "204": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Ressource absente"
          },
          "409": {
            "description": "Doublon ou catégorie liée"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
