    "/api/products/search": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Rechercher, filtrer, paginer et trier",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Casque"
          },
          {
            "name": "minPrice",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 0
          },
          {
            "name": "maxPrice",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 100
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 0
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "price"
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "asc"
          }
        ],
        "responses": {
          "200": {
            "description": "data, total, limit, offset"
          },
          "400": {
            "description": "Filtres invalides"
          }
        }
      }
    },
    "/api/products/with-category": {
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Transaction : créer produit et catégorie si absente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductWithCategory"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction validée"
          },
          "400": {
            "description": "Données invalides"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductInput": {
        "type": "object",
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150,
            "example": "Casque audio"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": true,
            "maximum": 99999999.99,
            "example": 59.99,
            "minimum": 0
          },
          "category_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "example": 1
          }
        }
      },
      "CategoryInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Audio"
          }
        }
      },
      "ProductWithCategory": {
        "type": "object",
        "required": [
          "name",
          "price",
          "categoryName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150,
            "example": "Casque audio"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": true,
            "maximum": 99999999.99,
            "example": 59.99,
            "minimum": 0
          },
          "categoryName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Audio"
          }
        }
      }
    }
  }
}
