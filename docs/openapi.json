          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "put": {
        "tags": [
          "Categories"
        ],
        "summary": "Remplacer categories",
        "responses": {
          "200": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Ressource absente"
          },
          "409": {
