{
  "openapi": "3.0.3",
  "info": {
    "title": "LAB 6 — API Produits / MySQL",
    "version": "1.0.0",
    "description": "Mohammed Noureddine — mysql2/promise, CRUD, recherche et transactions. Prix lus en chaînes décimales pour conserver leur précision."
  },
  "paths": {
    "/api/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Lister products",
        "responses": {
          "200": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Ressource absente"
          },
          "409": {
            "description": "Doublon ou catégorie liée"
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Créer products",
        "responses": {
          "201": {
            "description": "Succès"
          },
          "400": {
            "description": "Données invalides"
          },
          "404": {
            "description": "Ressource absente"
          },
          "409": {
            "description": "Doublon ou catégorie liée"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        }
      }
    },
